{
  "name": "agent-coding-ui",
  "version": "0.1.0",
  "description": "A Typora-style wrapper around terminal sessions for agent coding with Claude Code",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "test-emoji": "node src/emoji.js",
    "postinstall": "electron-rebuild -f -w node-pty",
    "package": "electron-packager . \"Agent Coding\" --platform=darwin --arch=arm64 --icon=build/icon.icns --out=dist --overwrite --ignore=\"^/dist\" --ignore=\"^/build/icon.iconset\" --ignore=\"^/build/render-icon.js\" && codesign --force --deep --sign - \"dist/Agent Coding-darwin-arm64/Agent Coding.app\"",
    "install_app": "npm run package && rm -rf \"/Applications/Agent Coding.app\" && cp -R \"dist/Agent Coding-darwin-arm64/Agent Coding.app\" /Applications/ && xattr -cr \"/Applications/Agent Coding.app\" && codesign --force --deep --sign - \"/Applications/Agent Coding.app\""
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@electron/rebuild": "^3.7.1",
    "electron": "^33.2.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "node-pty@1.1.0": true
  },
  "productName": "Agent Coding"
}
